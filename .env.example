# GEMINI_API_KEY: Required if Gemini AI API calls are used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional External Deepfake Detection Model Inference Endpoint (server-side only)
# Leave unset to return MODEL_NOT_CONFIGURED on /api/analyze-audio and use Experimental Signal-Analysis in demo mode.
FASTAPI_AUDIO_SERVICE_URL=""
DEEPFAKE_MODEL_ENDPOINT=""
DEEPFAKE_MODEL_API_KEY=""
